# Run RoleReady against Floci (local Google Cloud emulator).
#   cp .env.floci.example .env.floci
#   docker compose up -d floci-gcp
#   python scripts/floci_seed.py            # creates test sign-in users in emulated Firebase Auth
#   uvicorn app.main:create_app --factory --reload --env-file .env.floci
#
# Same code path as Cloud Run (Firestore store + Firebase sign-in), pointed at localhost:4588.

STORE_BACKEND=firestore
AUTH_MODE=firebase
GOOGLE_CLOUD_PROJECT=floci-local
FIRESTORE_EMULATOR_HOST=localhost:4588

# Firebase Auth emulator: accepts UNSIGNED test tokens. Local only. The app refuses to start
# on Cloud Run if this is set.
FIREBASE_AUTH_EMULATOR_HOST=localhost:4588
FIREBASE_PROJECT_ID=floci-local
FIREBASE_API_KEY=floci-local-key
FIREBASE_AUTH_DOMAIN=localhost

WORKSPACE_ID=bloom-and-crumb
WORKSPACE_NAME="Bloom & Crumb"
OWNER_EMAIL=owner@bloomandcrumb.test
DEFAULT_TIMEZONE=America/Chicago

# Optional: real NVIDIA key for the assistant (Floci does not emulate NVIDIA)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_DISABLE_THINKING=true
