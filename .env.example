# Copy to .env for local development:  cp .env.example .env
# .env is in .gitignore. Never commit real keys.

# Local defaults: in-memory data, demo sign-in (pick a user from a dropdown)
STORE_BACKEND=memory
AUTH_MODE=demo

WORKSPACE_ID=bloom-and-crumb
WORKSPACE_NAME="Bloom & Crumb"
OWNER_EMAIL=owner@bloomandcrumb.test
DEFAULT_TIMEZONE=America/Chicago
INVITE_TTL_HOURS=72

# NVIDIA (build.nvidia.com -> profile menu -> Settings -> API Keys). Leave empty to hide the assistant.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=15
# Keep reasoning off: reasoning models otherwise use up max_tokens and reply with nothing.
NVIDIA_DISABLE_THINKING=true

# Cloud only (set by infra/deploy.sh and infra/scheduler.sh)
# GOOGLE_CLOUD_PROJECT=
# SCHEDULER_AUDIENCE=https://roleready-xxxxx-uc.a.run.app
# SCHEDULER_SERVICE_ACCOUNT=roleready-scheduler@PROJECT_ID.iam.gserviceaccount.com
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=          (public web config, not a secret)
# FIREBASE_AUTH_DOMAIN=
# ALLOW_DEMO_AUTH_ON_CLOUD_RUN=false
